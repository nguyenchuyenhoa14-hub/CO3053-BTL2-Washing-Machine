# Allow non-root access to the STM32 ROM DFU bootloader and ST-Link probes.
#   sudo cp board/weact_h750/99-weact-h750.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
SUBSYSTEM=="usb", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="df11", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="374[8-9b-f]", MODE="0666", TAG+="uaccess"
